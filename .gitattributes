# Set default behavior to automatically handle line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.csv text eol=lf

# Denote all binary files to avoid corruption
*.joblib binary
*.pkl binary
*.parquet binary
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.db binary
*.sqlite binary
