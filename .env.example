# ============================================================
# Copy this file to .env  and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mlsecops
POSTGRES_USER=mlsecops_user
POSTGRES_PASSWORD=changeme

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=

# --- AWS / artifact store (optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Alerting ---
ALERT_WEBHOOK_URL=

# --- API ---
API_SECRET_KEY=changeme-api-key

# --- Authentication (JWT) ---
# REQUIRED: The application will NOT start without this variable set.
# Generate a strong random secret (minimum 32 hex chars recommended):
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=CHANGE-ME-TO-A-STRONG-RANDOM-SECRET
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Prometheus push gateway (optional) ---
PUSHGATEWAY_URL=http://localhost:9091
